# ─────────────────────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/
*.egg

# ─────────────────────────────────────────────────────────────────────────────
# Virtual environments
# ─────────────────────────────────────────────────────────────────────────────
venv/
env/
.venv/
.env/
ENV/

# ─────────────────────────────────────────────────────────────────────────────
# Secrets — never commit
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
credentials.json
service-account.json
kaggle.json
.kaggle/
.config/earthengine/

# ─────────────────────────────────────────────────────────────────────────────
# Data — too large for git, easily reproducible from GEE / Kaggle
# ─────────────────────────────────────────────────────────────────────────────
wildfire_data/
wildfire_output/
*.parquet
*.npy
*.npz
*.tfrecord
*.tfrecord-*
research_extracted.txt
research_extracted.docx

# Allow-list: ship the latest real-data dashboard snapshot as a deployable artifact.
# (GitHub Actions has no GEE creds, so the gh-pages live URL serves this fixed
#  Sept 15 2025 snapshot instead of fake synthetic data.)
!wildfire_output/
wildfire_output/*
!wildfire_output/2025-09-15/
wildfire_output/2025-09-15/*
!wildfire_output/2025-09-15/heatmap_2025-09-15.html
!wildfire_output/2025-09-15/summary_2025-09-15.json
!wildfire_output/2025-09-15/ignition_2025-09-15.parquet

# ─────────────────────────────────────────────────────────────────────────────
# Trained model artifacts — large, regenerable from training scripts
# ─────────────────────────────────────────────────────────────────────────────
wildfire_models/
*.pt
*.pth
*.onnx
*.h5

# Allow-list: ship the trained XGBoost ignition model so reviewers can run
# predict.py / dashboard.py against real-world data without retraining.
!wildfire_models/
wildfire_models/*
!wildfire_models/west_coast_wildfire_model.json
!wildfire_models/feature_meta.json

# ─────────────────────────────────────────────────────────────────────────────
# Unrelated app in this directory — not part of the wildfire project
# (a Streamlit/Flask stock-market predictor that happens to live here)
# ─────────────────────────────────────────────────────────────────────────────
quant_predictor.py
server.py
config.toml
# root requirements.txt is for the unrelated stock app; wildfire uses wildfire/requirements.txt
/requirements.txt

# ─────────────────────────────────────────────────────────────────────────────
# Claude Code local config — not part of the project
# ─────────────────────────────────────────────────────────────────────────────
.claude/

# ─────────────────────────────────────────────────────────────────────────────
# IDE / OS
# ─────────────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─────────────────────────────────────────────────────────────────────────────
# Notebook / temp
# ─────────────────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.log
*.tmp
demo*.parquet
demo*.npz
demo*.npy
